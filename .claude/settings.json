{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose ps *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose run --rm *)",
      "Bash(docker compose up -d *)",
      "Bash(docker compose restart *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(gh auth status *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "WebFetch(domain:laravel.com)",
      "WebFetch(domain:php.net)",
      "WebFetch(domain:www.php.net)",
      "WebFetch(domain:owasp.org)",
      "WebFetch(domain:cheatsheetseries.owasp.org)",
      "WebFetch(domain:dev.mysql.com)",
      "WebFetch(domain:mariadb.com)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:pestphp.com)",
      "WebFetch(domain:github.com)",
      "mcp__laravel-boost__*"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(docker compose down *)",
      "Bash(docker compose config *)",
      "Bash(docker volume *)",
      "Bash(docker system prune *)",
      "Bash(docker compose exec *migrate:fresh*)",
      "Bash(docker compose exec *migrate:refresh*)",
      "Bash(docker compose exec *migrate:reset*)",
      "Bash(docker compose exec *migrate:rollback*)",
      "Bash(docker compose exec *db:wipe*)",
      "Bash(docker compose exec *db:seed*)",
      "Bash(docker compose exec *queue:flush*)",
      "Bash(docker compose exec *queue:clear*)",
      "Bash(docker compose exec *--force*)",
      "Bash(docker compose exec *DROP TABLE*)",
      "Bash(docker compose exec *DROP DATABASE*)",
      "Bash(docker compose exec *TRUNCATE*)",
      "Bash(docker compose exec *DELETE FROM*)",
      "Bash(docker compose exec *UPDATE *SET*)",
      "Bash(docker compose exec *drop table*)",
      "Bash(docker compose exec *drop database*)",
      "Bash(docker compose exec *truncate*)",
      "Bash(docker compose exec *delete from*)",
      "Bash(docker compose exec *update *set*)"
    ],
    "deny": [
      "Bash(php *)",
      "Bash(composer *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(mysql *)",
      "Bash(mysqldump *)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(redis-cli *)",
      "Bash(./vendor/bin/*)",
      "Bash(vendor/bin/*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin develop *)",
      "Bash(git push * HEAD:main *)",
      "Bash(git push * HEAD:develop *)",
      "Bash(docker compose exec * printenv*)",
      "Bash(docker compose exec * env)",
      "Read(./.env)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.backup)",
      "Read(./auth.json)",
      "Read(./storage/*.key)",
      "Read(./**/*.pem)"
    ]
